datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model EventState {
  id           String   @id @default("JAWS-SAGA")
  eventCode    String   @unique
  title        String   @default("JAWS-UG佐賀 チーム割り当て")
  patternJson  String   @default("{\"teams\":[]}")
  teamsJson    String   @default("[]")
  commentsJson String   @default("{}")
  updatedAt    DateTime @updatedAt
}

model Participant {
  id          Int      @id @default(autoincrement())
  eventCode   String
  displayName String
  createdAt   DateTime @default(now())

  @@unique([eventCode, displayName])
}
